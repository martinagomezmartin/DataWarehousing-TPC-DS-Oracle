# Oracle settings read by tpcds.sh. Copy this file:  cp .env.example .env
# then put YOUR values in .env (it is ignored by Git, never commit it).

ORACLE_USER=TPCDS
ORACLE_PASSWORD=change_me
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1

# Folder with sf<N>/ (base data) and sf<N>_update/ (refresh data sets)
DATA_DIR=tpcds-data.nosync
# tools/ folder of the TPC-DS kit (dsdgen, dsqgen, answer_sets next to it)
TPCDS_TOOLS=tpcds/DSGen-software-code-4.0.0/tools